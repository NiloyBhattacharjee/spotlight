# One page's settings. Copy to books.env or stories.env (kept out of git) and fill in the platforms you use;
# leave a line empty to skip that platform. Only these values are used for that page.

# Instagram and Facebook: run  python reelbot.py --meta  with a Meta system user token and paste its output
IG_USER_ID=
IG_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=
# YouTube channel: a Desktop OAuth client, then once: python reelbot.py --env <page>.env --login youtube
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# TikTok app, then once: python reelbot.py --env <page>.env --login tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# SELF_ONLY until TikTok audits the app, then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# Book art without a logo: Cloudflare Workers AI (free daily allowance). Account ID from the dashboard,
# token from My Profile > API Tokens > Create Token > Workers AI template. Empty = Pollinations.
CF_ACCOUNT_ID=
CF_API_TOKEN=
